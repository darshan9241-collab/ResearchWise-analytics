# Copy to .env.local and fill in. All values are public (they ship to the browser) — never put secrets here.

# Full public URL of the site, no trailing slash. Used for canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=

# WhatsApp number in international format, digits only (country code + number). Overrides the default in src/config/site.ts.
VITE_WHATSAPP_NUMBER=916362620859

# Public contact email address.
VITE_CONTACT_EMAIL=researchwiseanalytics@gmail.com

# Full Instagram profile URL.
VITE_INSTAGRAM_URL=https://www.instagram.com/researchwise_analytics/

# Endpoint that accepts a JSON POST from the contact form (e.g. Formspree, a serverless function).
# Leave empty and the form will offer to send the enquiry via WhatsApp or email instead.
VITE_FORM_ENDPOINT=

